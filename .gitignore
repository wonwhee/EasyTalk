# EasyTalk .gitignore

# 운영체제 관련
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 편집기 관련
.vscode/
.idea/
*.swp
*.swo
*~

# 로그 파일
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 의존성 디렉토리
node_modules/
jspm_packages/

# 빌드 출력
dist/
build/
out/

# 환경 변수 파일 (API 키 등)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 테스트 커버리지
coverage/

# 임시 파일
*.tmp
*.temp

# 개인 설정 파일
config.local.js
api-keys.js

# 백업 파일
*.bak
*.backup

# 압축 파일
*.zip
*.tar.gz
*.rar

# 문서 임시 파일
~$*.docx
~$*.pptx
~$*.xlsx

# GitHub Pages
_site/

# Jekyll
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Vercel
.vercel

# Netlify
.netlify/
